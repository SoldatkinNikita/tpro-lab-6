<%
try {
  const fs=require('fs'),path=require('path'),root=path.resolve('lab6');
  require(path.resolve('scripts/polish-model.cjs'))(app);
  const lab=app.repository.getInstancesOf('UMLPackage').find(p=>p.name==='06. Проектирование и инженерия');
  const under=x=>{for(let p=x;p;p=p._parent)if(p===lab)return true;return false;};
  const errors=app.validator.validate();
  fs.writeFileSync(path.join(root,'validation/staruml-validation.json'),JSON.stringify({tool:'StarUML '+app.metadata.version,method:'app.validator.validate()',errors,sourceErrors:errors.filter(e=>!under(app.repository.get(e.id))),lab6Errors:errors.filter(e=>under(app.repository.get(e.id)))},null,2));
  app.project.save(path.join(root,'ARIA-Lab6.mdj'));
  for(const d of app.repository.getInstancesOf('Diagram').filter(under)){
    const id=d.name.slice(0,2);
    app.commands.execute('project:export-diagram-to-svg',d,path.join(root,'diagrams',id+'.svg'));
    app.commands.execute('project:export-diagram-to-png',d,path.join(root,'diagrams',id+'.png'));
    require('C:/Program Files/StarUML/resources/app.asar/src/engine/diagram-export').exportToPDF([d],path.join(root,'diagrams',id+'.pdf'),{size:'A4',layout:'portrait',showName:false});
  }
  app.commands.execute('html-export:export',path.join(root,'docs/html'));
}catch(error){require('fs').writeFileSync('lab6/logs/inspect-error.txt',error.stack);throw error;}
%>
